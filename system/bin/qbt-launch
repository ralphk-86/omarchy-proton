#!/usr/bin/env bash
# ============================================================================
#  qbt-launch - start qBittorrent INSIDE the isolated VPN namespace.
#
#  Entering a network namespace requires root, so this is permitted
#  passwordless via /etc/sudoers.d/99-vpnkit. It is written to be safe to
#  grant:
#
#    * the executed binary is HARDCODED (/usr/bin/qbittorrent) - callers
#      cannot substitute it
#    * privileges are dropped to the desktop user with runuser BEFORE exec, so
#      qBittorrent never runs as root
#    * any arguments are passed only to the already-unprivileged process
#    * it refuses to run at all if the tunnel is down (fail closed)
#
#  Called by /usr/local/bin/qbittorrent (the PATH wrapper) and the desktop
#  launcher override.
# ============================================================================
set -euo pipefail

. /usr/local/lib/vpnkit/common.sh   # NS, WG_IF, TARGET_USER, TARGET_UID, ...
BIN="/usr/bin/qbittorrent"   # hardcoded on purpose: see the header

if [[ ! -x "$BIN" ]]; then
  echo "qbt-launch: $BIN not found" >&2
  exit 1
fi

if ! ip netns list 2>/dev/null | grep -qw "$NS"; then
  echo "qbt-launch: VPN namespace '$NS' is not running." >&2
  echo "Start it with: sudo systemctl start qbt-netns.service" >&2
  exit 1
fi

# FAIL CLOSED: refuse unless the namespace's resolver files are in place.
# `ip netns exec` mounts them over /etc only if they exist when qBittorrent
# enters, and it keeps whatever it got for its whole life; without them it would
# use the host's nsswitch.conf, whose `resolve` module reaches systemd-resolved
# over a Unix socket and resolves outside the tunnel. Checked before the route,
# so a namespace still being built (or whose build failed) is refused.
if ! vpnkit_resolver_safe "/etc/netns/$NS"; then
  echo "qbt-launch: the VPN namespace's DNS settings (/etc/netns/$NS) are missing or unsafe - refusing." >&2
  echo "Rebuild the tunnel: sudo systemctl restart qbt-netns.service" >&2
  exit 1
fi

# FAIL CLOSED: refuse to launch unless the tunnel actually has a route.
if ! ip netns exec "$NS" ip route show default 2>/dev/null | grep -q .; then
  echo "qbt-launch: tunnel is DOWN - refusing to launch qBittorrent." >&2
  exit 1
fi

# FAIL CLOSED: a qBittorrent of the user running outside the namespace would be
# handed whatever this one is asked to open (see vpnkit_qbt_outside_pids).
OUTSIDE=$(vpnkit_qbt_outside_pids "$(stat -Lc '%i' /var/run/netns/"$NS")" "$TARGET_USER" | paste -sd' ' -)
if [[ -n "$OUTSIDE" ]]; then
  echo "qbt-launch: qBittorrent is already running outside the namespace (pid $OUTSIDE) - refusing." >&2
  echo "It would receive these torrents and download them outside the tunnel. Close it first." >&2
  exit 1
fi

# The GUI still works normally: a network namespace isolates networking only,
# and the Wayland socket is a filesystem socket, not a network one. The
# environment (runtime dir, session bus, display) is vpnkit_gui_env's.
vpnkit_gui_env "$TARGET_USER" "$TARGET_UID"
ENVV=("${VPNKIT_GUI_ENV[@]}")

cd "$(getent passwd "$TARGET_USER" | cut -d: -f6)" 2>/dev/null || cd /
exec ip netns exec "$NS" \
  runuser -u "$TARGET_USER" -- \
    env "${ENVV[@]}" "$BIN" "$@"
