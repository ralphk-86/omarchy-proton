#!/usr/bin/env bash
# omarchy-proton: installed by its setup, removed by its uninstaller (vpnkit).
# ============================================================================
#  vpn-direct - turn Chrome direct or SSH direct on or off.
#
#  Chrome direct keeps Google Chrome on the normal connection (and on the
#  resolver in DIRECT_DNS) while a desktop server is selected. SSH direct
#  does that for new connections to the SSH ports (DIRECT_SSH_PORTS in
#  /etc/vpnkit/vpnkit.conf, default 22): ssh, scp, sftp, rsync and git over
#  ssh. Everything else keeps following the bar.
#
#  USAGE
#    vpn-direct on        turn Chrome direct on (sudo -n vpnkit-direct on),
#                         then point the Chrome launcher entry at the wrapper
#    vpn-direct off       turn it off, then remove that launcher entry
#    vpn-direct ssh on    turn SSH direct on (sudo -n vpnkit-direct ssh on)
#    vpn-direct ssh off   turn it off
#    vpn-direct launcher  make the launcher entry follow the current state
#                         (install.sh runs this); "launcher off" removes it
#
#  The launcher entry is ~/.local/share/applications/google-chrome.desktop, a
#  copy of the packaged one with every Exec= pointing at
#  /usr/local/bin/google-chrome-stable. Its first line marks it as ours; a file
#  there without that line is yours: it is backed up before being replaced
#  (turning Chrome direct on is the request), never removed, and put back
#  when the kit's entry goes (off, or the uninstaller). lib/owned.sh does it.
#
#  Close Chrome once after turning it on or off, so its next start lands in
#  the right place.
# ============================================================================
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/vpnkit/owned.sh || { echo "vpn-direct: the kit is not installed (run its setup)" >&2; exit 1; }
SRC_DESK="/usr/share/applications/google-chrome.desktop"
DESK=$(vpnkit_chrome_desk "$HOME")
MARKER="$VPNKIT_CHROME_DESK_MARK"
WRAPPER="/usr/local/bin/google-chrome-stable"

launcher_on() {   # nothing when Chrome is not installed (no packaged entry)
  vpnkit_desk_override "$SRC_DESK" "$DESK" "$MARKER" /usr/bin/google-chrome-stable "$WRAPPER" "Chrome direct"
}

# Removes the kit's entry and puts a backup of yours back.
launcher_off() { vpnkit_desk_remove "$DESK" "$MARKER"; }

direct_is_on() { ( . /usr/local/lib/vpnkit/common.sh && . /usr/local/lib/vpnkit/direct.sh && vpnkit_direct_on ); }

chrome_running() { pgrep -u "$(id -u)" -f '^/opt/google/chrome/' >/dev/null 2>&1; }

case "$#:${1:-}:${2:-}" in
  1:on:)
    sudo -n /usr/local/bin/vpnkit-direct on
    launcher_on
    if chrome_running; then
      echo "Close Chrome and start it again: the running one still uses the VPN."
    fi
    ;;
  1:off:)
    sudo -n /usr/local/bin/vpnkit-direct off
    launcher_off
    ;;
  1:launcher:)
    if direct_is_on; then launcher_on; else launcher_off; fi
    ;;
  2:launcher:off)
    launcher_off
    ;;
  2:ssh:on)
    sudo -n /usr/local/bin/vpnkit-direct ssh on
    echo "Connections open before this keep their path; reconnect them to use your own IP."
    ;;
  2:ssh:off)
    sudo -n /usr/local/bin/vpnkit-direct ssh off
    ;;
  *)
    sed -n '3,30p' "$0" >&2
    exit 2
    ;;
esac
