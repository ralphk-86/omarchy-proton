#!/usr/bin/env bash
# omarchy-proton: installed by its setup, removed by its uninstaller (vpnkit).
# ============================================================================
#  qbt-netns-up - build an isolated network namespace containing ONLY a
#                 WireGuard tunnel, for qBittorrent to run inside.
#
#  The namespace is built by vpnkit_netns_up (/usr/local/lib/vpnkit/netns.sh),
#  which explains the design: no tunnel means no route and no resolver, so
#  nothing inside can escape, including DNS.
#
#  This is independent of the desktop VPN connection, so that can be toggled
#  freely without ever exposing qBittorrent.
#
#  Run via: systemctl start qbt-netns.service
# ============================================================================
# Runs as root (through sudo, or systemd): a fixed PATH before any command,
# because sudo hands the caller's PATH on when sudoers has no secure_path.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin"
set -euo pipefail

# All names, paths and provider quirks come from /etc/vpnkit/vpnkit.conf.
. /usr/local/lib/vpnkit/common.sh   # NS, WG_IF, QBT_CONF, FALLBACK_DNS, VPN_FWMARK, ...
. /usr/local/lib/vpnkit/netns.sh    # vpnkit_netns_up

log() { echo "[qbt-netns] $*"; }

# A plain statement (see netns.sh): set -e stays in force inside the function.
vpnkit_netns_up "$NS" "$WG_IF" "$QBT_CONF" qbtguard
