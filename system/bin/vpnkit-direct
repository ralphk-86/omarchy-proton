#!/usr/bin/bash
# ============================================================================
#  vpnkit-direct - turn Chrome direct on or off.
#
#  Chrome direct keeps Google Chrome on the normal connection while a desktop
#  server is selected. It is off until turned on here, and while off nothing of
#  it is loaded.
#
#    on      Refused unless DIRECT_DNS (vpnkit.conf) is empty, or a loopback
#            address whose resolver answers. Then: write /etc/vpnkit/direct-apps
#            (the rules helper loads nothing without it), enable and start
#            vpnkit-direct.service (the slice's cgroup and the rules), and
#            re-arm the kill switch if it is armed, so it lets the slice's
#            packets out. If the unit does not start, all of it is undone.
#            Prints "direct: on".
#    off     Refused while anything runs in the slice (close Chrome first).
#            Then the reverse of on, the exemption first: stop the unit and
#            remove the rules, and only then the state file. A step that
#            fails stops it there, so status never says off while the rules
#            are still loaded. Prints "direct: off".
#    status  JSON: {"enabled","unit","rules","dns_ok"}, all true or false.
#
#  Allowed passwordless via /etc/sudoers.d/99-vpnkit, with exactly these
#  arguments. Takes no paths; anything else exits 2.
# ============================================================================
set -euo pipefail
. /usr/local/lib/vpnkit/common.sh
. /usr/local/lib/vpnkit/direct.sh

UNIT="vpnkit-direct.service"
CG="/sys/fs/cgroup/$DIRECT_SLICE"

[[ $EUID -eq 0 ]] || { echo "vpnkit-direct: must run as root" >&2; exit 2; }
[[ $# -eq 1 ]] || { echo "usage: vpnkit-direct on | off | status" >&2; exit 2; }

# The kill switch reads the state file when it is armed: arm it again, for the
# same server, so it gains or loses the line for the mark.
rearm_killswitch() {
  local st profile
  st=$(/usr/local/bin/vpnkit-killswitch status 2>/dev/null) || return 0
  [[ "$st" == on* ]] || return 0
  profile=${st#on}; profile=${profile# }
  if [[ -n "$profile" ]]; then
    /usr/local/bin/vpnkit-killswitch on "$profile" >/dev/null
  else
    echo "vpnkit-direct: the kill switch is armed for an unknown server; choose the server again" >&2
  fi
}

# The exemption itself: the unit, the slice, the table and the policy rules.
# Each failure is reported; the caller decides what that means.
exemption_down() {
  local rc=0
  # A unit that will not stop keeps its rules: nothing else is touched then.
  systemctl stop "$UNIT" >/dev/null || { echo "vpnkit-direct: could not stop $UNIT" >&2; return 1; }
  systemctl stop "$DIRECT_SLICE" >/dev/null || { echo "vpnkit-direct: could not stop $DIRECT_SLICE" >&2; rc=1; }
  /usr/local/bin/vpnkit-direct-rules down || { echo "vpnkit-direct: could not remove the rules" >&2; rc=1; }
  if systemctl is-enabled --quiet "$UNIT" 2>/dev/null; then
    systemctl disable "$UNIT" >/dev/null 2>&1 || { echo "vpnkit-direct: could not disable $UNIT" >&2; rc=1; }
  fi
  return "$rc"
}

dns_ok() {
  [[ -z "$DIRECT_DNS" ]] || { vpnkit_loopback_ip "$DIRECT_DNS" && vpnkit_dns_answers "$DIRECT_DNS"; }
}

tf() { if "$@"; then echo true; else echo false; fi; }

case "$1" in
  on)
    if [[ -n "$DIRECT_DNS" ]]; then
      vpnkit_loopback_ip "$DIRECT_DNS" || {
        echo "vpnkit-direct: DIRECT_DNS must be empty or an address in 127.0.0.0/8 (got $DIRECT_DNS)" >&2; exit 1; }
      vpnkit_dns_answers "$DIRECT_DNS" || {
        echo "vpnkit-direct: the resolver at DIRECT_DNS ($DIRECT_DNS) does not answer; start it, or empty DIRECT_DNS" >&2; exit 1; }
    fi
    printf 'chrome\n' > "$DIRECT_STATE"
    chmod 644 "$DIRECT_STATE"
    if ! systemctl enable --now "$UNIT" >/dev/null 2>&1; then
      echo "vpnkit-direct: $UNIT did not start: journalctl -u $UNIT" >&2
      # Undo it all. Without a state file the kill switch has no line for the mark.
      if exemption_down; then
        rm -f "$DIRECT_STATE"
        rearm_killswitch
      else
        echo "vpnkit-direct: could not undo it; run: sudo vpnkit-direct off" >&2
      fi
      exit 1
    fi
    rearm_killswitch
    echo "direct: on"
    ;;
  off)
    if grep -qx 'populated 1' "$CG/cgroup.events" 2>/dev/null; then
      names=$(find "$CG" -name cgroup.procs -exec cat {} + 2>/dev/null \
              | while read -r pid; do cat "/proc/$pid/comm" 2>/dev/null || true; done | sort -u | paste -sd, -) || true
      echo "vpnkit-direct: still running with the normal connection: ${names:-unknown}. Close Chrome first." >&2
      exit 1
    fi
    # The exemption first: once the rules are gone, the kill switch's line for
    # the mark matches nothing. The state file goes only after that.
    exemption_down || { echo "vpnkit-direct: Chrome direct is still on" >&2; exit 1; }
    rm -f "$DIRECT_STATE"
    rearm_killswitch
    echo "direct: off"
    ;;
  status)
    jq -cn --argjson enabled "$(tf vpnkit_direct_on)" \
           --argjson unit "$(tf systemctl is-active --quiet "$UNIT")" \
           --argjson rules "$(tf vpnkit_direct_rules_loaded)" \
           --argjson dns_ok "$(tf dns_ok)" \
           '{enabled: $enabled, unit: $unit, rules: $rules, dns_ok: $dns_ok}'
    ;;
  *)
    echo "usage: vpnkit-direct on | off | status" >&2
    exit 2
    ;;
esac
