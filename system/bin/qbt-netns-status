#!/usr/bin/bash
# omarchy-proton: installed by its setup, removed by its uninstaller (vpnkit).
# ============================================================================
#  qbt-netns-status - read-only status of the qBittorrent VPN namespace,
#  AND verification that any running qBittorrent is actually inside it, and
#  that no other known torrent app is running outside it.
#
#  This is the trust anchor for the bar widget. It does not assume anything:
#  it compares the network-namespace inode of every running qbittorrent process
#  against the inode of the VPN namespace. A process is only reported as
#  protected if those inodes match - that is kernel ground truth, not a guess.
#
#  It also reports the Firefox tunnel (opt-in, "firefox" below) the same way:
#  its namespace, handshake and exit IP, and whether each Firefox of the
#  desktop user runs inside it; and Chrome direct (opt-in, "direct" below):
#  its unit and rules, whether DIRECT_DNS answers, which processes run in its
#  slice, and whether Chrome's private resolver files are still in place.
#
#  Allowed passwordless via /etc/sudoers.d/99-vpnkit.
#  Takes no arguments and only reads state. The only files it writes are its
#  own caches in /run (the torrent and Firefox exit IPs, and whether
#  DIRECT_DNS answered).
# ============================================================================
# Runs as root (through sudo, or systemd): a fixed PATH before any command,
# because sudo hands the caller's PATH on when sudoers has no secure_path.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin"
set -uo pipefail
. /usr/local/lib/vpnkit/common.sh   # NS, WG_IF, QBT_CONF, HANDSHAKE_MAX_AGE, ...
. /usr/local/lib/vpnkit/direct.sh   # Chrome direct
IPCACHE="/run/qbt-netns-exit-ip"
FF_IPCACHE="/run/ff-netns-exit-ip"
IPCACHE_TTL=60
now=$(date +%s)

# The tunnel in a namespace, as "<route> <handshake> <endpoint>": whether it
# has a default route, the time of its last handshake (0: none), and its
# peer's endpoint. Only for a namespace that exists.
tunnel_probe() {  # tunnel_probe <ns> <wg_if>
  local route=false hs ep
  ip netns exec "$1" ip route show default 2>/dev/null | grep -q . && route=true
  hs=$(ip netns exec "$1" wg show "$2" latest-handshakes 2>/dev/null | awk '{print $2}' | head -1)
  [[ "${hs:-}" =~ ^[0-9]+$ ]] || hs=0
  ep=$(ip netns exec "$1" wg show "$2" endpoints 2>/dev/null | awk '{print $2}' | head -1)
  printf '%s %s %s\n' "$route" "$hs" "${ep:--}"
}

# A namespace's actual exit IP (cached, this is the real proof), or empty.
# Without a working tunnel there is none, and the cache is dropped.
ns_exit_ip() {  # ns_exit_ip <ns> <cache file> <tunnel up: true|false>
  local ns="$1" cache="$2" addr="" age
  if [[ "$3" != true ]]; then rm -f "$cache" 2>/dev/null; return 0; fi
  if [[ -r "$cache" ]]; then
    age=$(( now - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
    if (( age < IPCACHE_TTL )); then
      { IFS= read -r addr < "$cache"; } 2>/dev/null || true
      [[ "$addr" =~ ^[0-9.]+$ ]] && { printf '%s' "$addr"; return 0; }
    fi
  fi
  # Bounded like vpnkit_fetch (see common.sh); a function cannot be run
  # through `ip netns exec`, so the flags are spelled out here.
  addr=$(ip netns exec "$ns" curl -4 -s --max-time 5 --max-filesize "$VPNKIT_MAX_BODY" "$IP_LOOKUP_URL" 2>/dev/null) || addr=""
  addr="${addr//[[:space:]]/}"
  # Only ever cache something that looks like an address.
  [[ "$addr" =~ ^[0-9.]+$ ]] || addr=""
  [[ -n "$addr" ]] && printf '%s' "$addr" > "$cache" 2>/dev/null
  printf '%s' "$addr"
}

exists=false; route=false; handshake=0; endpoint=""; server=""
qbt_running=false; qbt_protected=false; qbt_unprotected=false; qbt_pids=""
exit_ip=""
killswitch=false; wanted=""; configured=false
[[ -r "$QBT_CONF" ]] && configured=true

# --- desktop kill switch (needs root to read, so it is reported from here) ----
if nft list table inet vpnkit_kill >/dev/null 2>&1; then
  killswitch=true
  [[ -r /run/vpnkit/wanted ]] && wanted=$(head -1 /run/vpnkit/wanted | tr -cd 'A-Za-z0-9._-')
fi

if ip netns list 2>/dev/null | grep -qw "$NS"; then
  exists=true
  read -r route handshake endpoint < <(tunnel_probe "$NS" "$WG_IF")
  [[ "$endpoint" == - ]] && endpoint=""
fi
conn=$(head -1 /etc/vpnkit/torrent-server 2>/dev/null | tr -cd 'A-Za-z0-9._-')
if [[ -n "$conn" ]]; then server="${conn#"$PROFILE_PREFIX"-}"
elif [[ -r "$QBT_CONF" ]]; then server=$(vpnkit_server_tag "$QBT_CONF"); fi

tunnel_up=false
if [[ "$route" == true && "$handshake" -gt 0 ]] && (( now - handshake < HANDSHAKE_MAX_AGE )); then
  tunnel_up=true
fi

# --- verify running qBittorrent processes against the namespace -------------
# Kernel ground truth: /var/run/netns/<ns> is a bind mount of the namespace, so
# stat gives the namespace inode, and /proc/<pid>/ns/net gives the process's.
NS_INODE=""
if [[ "$exists" == true ]]; then
  NS_INODE=$(stat -Lc '%i' /var/run/netns/"$NS" 2>/dev/null)
fi

for pid in $(pgrep -x qbittorrent 2>/dev/null); do
  qbt_running=true
  qbt_pids="${qbt_pids:+$qbt_pids,}$pid"
  PID_NS=$(stat -Lc '%i' /proc/"$pid"/ns/net 2>/dev/null)
  if [[ -n "$NS_INODE" && "$PID_NS" == "$NS_INODE" ]]; then
    qbt_protected=true
  else
    qbt_unprotected=true
  fi
done

# --- other torrent apps: only qBittorrent is routed into the namespace --------
other_clients=$(vpnkit_outside_clients "$NS_INODE" | paste -sd, -)

# --- the namespace's actual exit IP (cached, this is the real proof) --------
exit_ip=$(ns_exit_ip "$NS" "$IPCACHE" "$tunnel_up")

# --- the Firefox tunnel (opt-in) ----------------------------------------------
# Computed like the torrent fields above. It is on once a Firefox server was
# chosen (vpnkit_ff_opted_in, or its config is in place); only then are the
# desktop user's Firefox processes looked at (by their program, FF_BIN, and
# their namespace inode; only main processes, see vpnkit_ff_pids: Firefox's
# sandboxed children have namespaces of their own). "pids" lists the ones
# outside the namespace. The namespace is never the torrent
# tunnel's, whatever vpnkit.conf says.
firefox_json() {
  local configured=false exists=false route=false hs=0 ep="" up=false addr="" conn server="" ino="" scan
  { [[ -r "$FF_CONF" ]] || vpnkit_ff_opted_in; } && configured=true
  if [[ "$FF_NS" != "$NS" && "$FF_NS" =~ ^[A-Za-z0-9._-]{1,32}$ && -e "/run/netns/$FF_NS" ]]; then
    exists=true
    read -r route hs ep < <(tunnel_probe "$FF_NS" "$FF_WG_IF")
    [[ "$ep" == - ]] && ep=""
    ino=$(stat -Lc '%i' "/run/netns/$FF_NS" 2>/dev/null) || ino=""
  fi
  conn=$(head -1 "$FF_SERVER_FILE" 2>/dev/null | tr -cd 'A-Za-z0-9._-')
  if [[ -n "$conn" ]]; then server="${conn#"$PROFILE_PREFIX"-}"
  elif [[ -r "$FF_CONF" ]]; then server=$(vpnkit_server_tag "$FF_CONF"); fi
  if [[ "$route" == true && "$hs" -gt 0 ]] && (( now - hs < HANDSHAKE_MAX_AGE )); then up=true; fi
  addr=$(ns_exit_ip "$FF_NS" "$FF_IPCACHE" "$up")
  scan=""
  [[ "$configured" == true ]] && scan=$(vpnkit_ff_pids "$ino" "$TARGET_USER" both)
  jq -Rsc --argjson configured "$configured" --argjson exists "$exists" --argjson route "$route" \
          --argjson up "$up" --argjson hs "$hs" --arg ep "$ep" --arg addr "$addr" \
          --arg server "$server" --arg conn "$conn" '
    split("\n") | map(select(. != "") | split(" ")) as $p
    | ($p | map(select(.[0] == "outside") | .[1])) as $out
    | {configured: $configured, exists: $exists, route: $route, tunnel_up: $up,
       last_handshake: $hs, endpoint: $ep, exit_ip: $addr, server: $server, conn: $conn,
       running: ($p | length > 0), protected: ($p | any(.[0] == "inside")),
       unprotected: ($out | length > 0), pids: ($out | join(","))}' <<<"$scan"
}
firefox=$(firefox_json 2>/dev/null) || firefox='{"configured":null}'
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$firefox" || firefox='{"configured":null}'

# --- Chrome direct (opt-in) ---------------------------------------------------
# Does DIRECT_DNS answer? The bar polls this every few seconds and a resolver
# that is down makes the question wait up to 3 s, so the answer is kept for
# DNSCACHE_TTL seconds, for the address it was asked of. (vpn-verify always
# asks afresh.)
DNSCACHE=/run/vpnkit/direct-dns
DNSCACHE_TTL=30
direct_dns_ok() {
  [[ -n "$DIRECT_DNS" ]] || { echo true; return; }
  vpnkit_loopback_ip "$DIRECT_DNS" || { echo false; return; }
  local line="" age r=false
  if [[ -f "$DNSCACHE" && ! -L "$DNSCACHE" ]]; then
    age=$(( now - $(stat -c %Y "$DNSCACHE" 2>/dev/null || echo 0) ))
    read -r line < "$DNSCACHE" 2>/dev/null || line=""
    if (( age >= 0 && age < DNSCACHE_TTL )) && [[ "$line" == "$DIRECT_DNS true" || "$line" == "$DIRECT_DNS false" ]]; then
      echo "${line##* }"; return
    fi
  fi
  vpnkit_dns_answers "$DIRECT_DNS" && r=true
  install -d -m 755 /run/vpnkit 2>/dev/null \
    && printf '%s %s\n' "$DIRECT_DNS" "$r" > "$DNSCACHE.$$" 2>/dev/null \
    && mv -f "$DNSCACHE.$$" "$DNSCACHE" 2>/dev/null
  echo "$r"
}

# The checks run only while it is on; while off they are null ("not checked").
# Every value is computed in one step (tf), not set by a chain of conditions.
tf() { if "$@"; then echo true; else echo false; fi; }
direct_json() {  # the "direct" object; {"enabled":null} when the scan did not finish
  local d_unit d_rules d_dns scan
  d_unit=$(tf systemctl is-active --quiet vpnkit-direct.service)
  d_rules=$(tf vpnkit_direct_rules_loaded)
  d_dns=$(printf '%s' "$DIRECT_DNS" | tr -cd '0-9A-Za-z.:' | head -c 64)
  if ! vpnkit_direct_on; then
    jq -cn --argjson unit "$d_unit" --argjson rules "$d_rules" --arg dns "$d_dns" \
      '{enabled: false, unit: $unit, rules: $rules, dns: $dns, dns_ok: null, chrome_inside: false,
        chrome_outside: false, override_ok: null, helpers: "", others: ""}'
    return
  fi
  # Only a scan that ran to its end ("done") counts; otherwise the whole
  # object says unknown, never "nothing else in the slice".
  scan=$(vpnkit_direct_scan "$TARGET_USER" 2>/dev/null) || scan=""
  [[ "$(tail -n 1 <<<"$scan")" == done ]] || { echo '{"enabled":null}'; return; }
  # The override applies only with DIRECT_DNS set and Chrome running; every
  # Chrome process that sees a file system must have it, and at least one must.
  jq -Rsc --argjson unit "$d_unit" --argjson rules "$d_rules" --arg dns "$d_dns" \
          --argjson dns_set "$(tf test -n "$DIRECT_DNS")" --argjson dns_ok "$(direct_dns_ok)" '
    split("\n") | map(select(. != "") | split(" ")) as $l
    | ($l | map(select(.[0] == "chrome"))) as $c
    | def names(k): $l | map(select(.[0] == k) | .[1]) | unique | join(",");
    {enabled: true, unit: $unit, rules: $rules, dns: $dns, dns_ok: $dns_ok,
     chrome_inside: ($c | length > 0),
     chrome_outside: ($l | any(.[0] == "outside")),
     override_ok: (if ($dns_set | not) or ($c | length) == 0 then null
                   else (($c | all(.[2] != "bad")) and ($c | any(.[2] == "ok"))) end),
     helpers: names("helper"), others: names("other")}' <<<"$scan"
}
direct=$(direct_json) || direct='{"enabled":null}'
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$direct" || direct='{"enabled":null}'

printf '{"exists":%s,"route":%s,"tunnel_up":%s,"last_handshake":%s,"endpoint":"%s","server":"%s","exit_ip":"%s","qbt_running":%s,"qbt_protected":%s,"qbt_unprotected":%s,"qbt_pids":"%s","killswitch":%s,"wanted":"%s","configured":%s,"conn":"%s","other_clients":"%s","firefox":%s,"direct":%s}\n' \
  "$exists" "$route" "$tunnel_up" "$handshake" "$endpoint" "$server" "$exit_ip" \
  "$qbt_running" "$qbt_protected" "$qbt_unprotected" "$qbt_pids" "$killswitch" "$wanted" "$configured" "$conn" "$other_clients" "$firefox" "$direct"
