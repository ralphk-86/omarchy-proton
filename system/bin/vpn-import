#!/usr/bin/env bash
# omarchy-proton: installed by its setup, removed by its uninstaller (vpnkit).
# ============================================================================
#  vpn-import - import WireGuard configs from the drop folder.
#
#  The same thing the Refresh row in the VPN panel does.
#
#  Usage:
#     vpn-import                     import whatever is waiting in the folder
#     vpn-import a.conf b.conf       move these into the folder first, then import
#     vpn-import --torrent x.conf    use this config for the torrent tunnel
#     vpn-import --firefox x.conf    use this config for the Firefox tunnel (turns it on)
#
#  Every config is a separate session with its own key. Never use one config
#  in two places: on most providers a duplicate drops BOTH tunnels. The torrent
#  and Firefox configs in particular must be used nowhere else, and must be
#  for two different servers.
# ============================================================================
set -uo pipefail
. /usr/local/lib/vpnkit/common.sh

mkdir -p "$CONFIG_DIR/torrent" "$CONFIG_DIR/firefox" && chmod 700 "$CONFIG_DIR" "$CONFIG_DIR/torrent" "$CONFIG_DIR/firefox"

dest="$CONFIG_DIR"
for f in "$@"; do
  if [[ "$f" == "--torrent" ]]; then dest="$CONFIG_DIR/torrent"; continue; fi
  if [[ "$f" == "--firefox" ]]; then dest="$CONFIG_DIR/firefox"; continue; fi
  [[ -f "$f" ]] || { echo "skip: no such file: $f"; continue; }
  mv -- "$f" "$dest/" && chmod 600 "$dest/$(basename "$f")"
  dest="$CONFIG_DIR"
done

out=$(sudo -n /usr/local/bin/vpnkit-sync sync) || { echo "vpnkit-sync failed. Is vpnkit installed?"; exit 1; }
jq -r '
  (.imported[] | "imported: \(.)"),
  (if .torrent != "" then "torrent tunnel: \(.torrent)" else empty end),
  (if (.firefox // "") != "" then "Firefox tunnel: \(.firefox)" else empty end),
  (.skipped[] | "skipped: \(.file): \(.reason)"),
  (if .note != "" then .note else empty end),
  (if (.imported|length) == 0 and .torrent == "" and (.firefox // "") == "" and (.skipped|length) == 0
   then "Nothing new in \(.folder)" else empty end)' <<<"$out"
