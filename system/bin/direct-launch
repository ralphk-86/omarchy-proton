#!/usr/bin/env bash
# ============================================================================
#  direct-launch - start Google Chrome in Chrome direct's slice, so it keeps
#  the normal connection while a desktop server is selected.
#
#  Putting a process into the system cgroup vpnkitdirect.slice needs root, so
#  this is permitted passwordless via /etc/sudoers.d/99-vpnkit. It is written
#  to be safe to grant:
#
#    * the executed binary is HARDCODED (DIRECT_BIN, /usr/bin/google-chrome-stable)
#    * Chrome runs as the desktop user, never as root: systemd-run drops
#      privileges after placing the process in the slice
#    * the arguments go to Chrome only, and the ones that make Chrome run
#      another program as its child are refused (--*-cmd-prefix,
#      --*-launcher, --browser-subprocess-path), on the command line and in
#      the user's chrome-flags.conf
#    * it refuses while Chrome direct is off or its rules are not loaded, and
#      while a Chrome of the user runs outside the slice (a new Chrome hands
#      its windows to the running one, which would open them there)
#
#  Chrome must stay in the slice. On every start it asks the user's service
#  manager (org.freedesktop.systemd1 on the session bus) for a scope of its
#  own, and that would move it out of the slice, onto the VPN, with every
#  process it starts afterwards. So Chrome gets a filtered session bus: a proxy
#  (xdg-dbus-proxy, run as the user, outside the slice) that lets it reach the
#  portals, the secret service, notifications and the few other services
#  listed below, and on which the service manager does not exist. The proxy
#  ends when Chrome does. If it does not start, Chrome is not started.
#
#  Apps Chrome opens (links, downloads, mailto: ...) go through xdg-open; the
#  first one in Chrome's PATH is the kit's (DIRECT_PATH_DIR), which starts the
#  app outside the slice, so it follows the bar.
#
#  With DIRECT_DNS set, Chrome gets a private mount namespace in which
#  /etc/resolv.conf names DIRECT_DNS only and /etc/nsswitch.conf has no
#  `resolve` or `mdns`, so names are resolved by DIRECT_DNS and not by
#  systemd-resolved (which would use the VPN's resolver). /etc/resolv.conf is
#  a symlink into /run/systemd/resolve, and resolved replaces those files by
#  renaming, which would undo a bind mount of a single file; so a tmpfs is
#  mounted over the whole directory instead. Mount propagation is "slave":
#  drives mounted later still show up in Chrome.
#
#  Called by /usr/local/bin/google-chrome-stable (the PATH wrapper).
# ============================================================================
set -euo pipefail
. /usr/local/lib/vpnkit/common.sh   # TARGET_USER, TARGET_UID, DIRECT_DNS, ...
. /usr/local/lib/vpnkit/direct.sh   # DIRECT_*, the Chrome direct helpers

[[ $EUID -eq 0 ]] || { echo "direct-launch: must run as root" >&2; exit 2; }

refuse() { echo "direct-launch: $*" >&2; exit 1; }

[[ -x "$DIRECT_BIN" ]] || refuse "$DIRECT_BIN not found"
vpnkit_direct_on || refuse "Chrome direct is off - refusing. Start Chrome as usual: $DIRECT_BIN"
systemctl is-active --quiet vpnkit-direct.service \
  || refuse "Chrome direct is on but vpnkit-direct.service is not active - refusing. See: journalctl -u vpnkit-direct.service"
[[ -d "/sys/fs/cgroup/$DIRECT_SLICE" ]] || refuse "the slice $DIRECT_SLICE does not exist - refusing"

for a in "$@"; do
  vpnkit_chrome_flag_refused "$a" && refuse "refusing the flag ${a%%=*}: it makes Chrome start another program, which would get the normal connection too"
done

THOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
TGROUP=$(id -gn "$TARGET_USER")
[[ -n "$THOME" && -n "$TGROUP" ]] || refuse "unknown desktop user '$TARGET_USER'"

# /usr/bin/google-chrome-stable adds every flag in ~/.config/chrome-flags.conf
# (Omarchy keeps its Wayland flags there): `grep -v '^#'` over the whole file,
# expanded unquoted, so split on whitespace AND globbed against Chrome's
# working directory. The check fails closed: a file it cannot read whole (too
# large, unreadable, too slow) or a word that would be globbed is refused.
# Read with the user's rights, never root's: the test for the file too, so it
# sees what the package script will see.
FLAGS_CONF="$THOME/.config/chrome-flags.conf"
FLAGS_MAX=65536
FLAGS_TMP=$(mktemp)
trap 'rm -f "$FLAGS_TMP"' EXIT
rc=0
setpriv --reuid="$TARGET_UID" --regid="$(id -g "$TARGET_USER")" --init-groups -- \
  timeout 2 bash -c '[[ -f $1 ]] || exit 10; exec head -c "$2" -- "$1"' _ "$FLAGS_CONF" "$((FLAGS_MAX + 1))" \
  > "$FLAGS_TMP" 2>/dev/null || rc=$?
case "$rc" in
  10) ;;   # no such file: no flags
  0)
    (( $(stat -c %s "$FLAGS_TMP") <= FLAGS_MAX )) \
      || refuse "refusing: $FLAGS_CONF is larger than $FLAGS_MAX bytes, too large to check"
    # -a: every line any locale's grep would pass on, never "binary file matches".
    USER_FLAGS=$(grep -av '^#' "$FLAGS_TMP") || USER_FLAGS=""
    read -ra USER_FLAGS <<<"$(tr '\n' ' ' <<<"$USER_FLAGS")"
    for a in "${USER_FLAGS[@]}"; do
      [[ "$a" == *[\*\?\[]* ]] \
        && refuse "refusing: $FLAGS_CONF has a wildcard word ($a), which the Chrome script would expand into file names"
      vpnkit_chrome_flag_refused "$a" \
        && refuse "refusing: $FLAGS_CONF has the flag ${a%%=*}, which makes Chrome start another program"
    done
    ;;
  *) refuse "refusing: $FLAGS_CONF could not be read to check its flags (exit $rc)" ;;
esac
rm -f "$FLAGS_TMP"; trap - EXIT

OUTSIDE=$(vpnkit_chrome_outside_pids "$TARGET_USER" | paste -sd' ' -)
[[ -z "$OUTSIDE" ]] || refuse "Chrome is already running outside Chrome direct (pid $OUTSIDE) - refusing. It would open this window itself, on the VPN. Close it first."

if [[ -n "$DIRECT_DNS" ]]; then
  vpnkit_loopback_ip "$DIRECT_DNS" || refuse "DIRECT_DNS must be empty or an address in 127.0.0.0/8 (got $DIRECT_DNS)"
  # The override replaces the directory /etc/resolv.conf points into.
  case "$(readlink -f /etc/resolv.conf)" in
    /run/systemd/resolve/*) ;;
    *) refuse "/etc/resolv.conf does not point into /run/systemd/resolve (systemd-resolved), so DIRECT_DNS cannot be applied - refusing" ;;
  esac
fi

[[ -x "$DIRECT_PROXY" ]] \
  || refuse "$DIRECT_PROXY is missing (package xdg-dbus-proxy), so Chrome could move itself out of Chrome direct - refusing. Run the setup again"
[[ -x "$DIRECT_PATH_DIR/xdg-open" ]] \
  || refuse "$DIRECT_PATH_DIR/xdg-open is missing, so apps Chrome opens would get the normal connection too - refusing. Run the setup again"
RUNDIR="/run/user/$TARGET_UID"
[[ -d "$RUNDIR" ]] || refuse "$RUNDIR does not exist: $TARGET_USER has no session - refusing"

# --- Chrome's session bus: a filtered proxy of the user's ------------------
# What Chrome may reach on it. Nothing at all of org.freedesktop.systemd1
# (the user's service manager): under --filter a name without a rule does not
# exist. The tray icon is not possible: its bus name
# (org.kde.StatusNotifierItem-<pid>-<n>) cannot be granted through the proxy.
BUS_POLICY=(
  --talk='org.freedesktop.portal.*'        # file chooser, screen sharing, settings, network status
  --talk=org.freedesktop.secrets           # saved passwords (libsecret)
  --talk=org.freedesktop.Notifications
  --talk=org.freedesktop.ScreenSaver       # keeps the screen on during a video
  --talk=org.freedesktop.FileManager1      # "Show in folder"
  --talk=org.a11y.Bus
  --talk=org.kde.StatusNotifierWatcher
  --talk=ca.desrt.dconf
  --talk='org.gtk.vfs.*'
  --own='org.mpris.MediaPlayer2.chrome.*'  # media keys
)
TGID=$(id -g "$TARGET_USER")
as_target() { setpriv --reuid="$TARGET_UID" --regid="$TGID" --init-groups -- "$@"; }
# The socket lives in the user's runtime dir, made and cleaned by the user,
# never by root. A user who swaps it can only make Chrome leave the slice.
BUSDIR="$RUNDIR/vpnkit-direct"
BUSSOCK="$BUSDIR/bus-$$"
as_target mkdir -p -m 700 "$BUSDIR" || refuse "could not create $BUSDIR - refusing"
as_target rm -f "$BUSSOCK" || refuse "could not clear $BUSSOCK - refusing"
# The proxy's lifetime: it gets the write end of a pipe (--fd) and exits when
# no reader is left; the read end is held here and handed on to Chrome
# through exec, and nothing else has it. It writes one byte once it listens.
SYNC_DIR=$(mktemp -d)
mkfifo -m 600 "$SYNC_DIR/sync"
exec {SYNC_R}<>"$SYNC_DIR/sync"   # read-write: opening does not wait for a writer
exec {SYNC_W}>"$SYNC_DIR/sync"
rm -rf "$SYNC_DIR"
# Run as the user, in the caller's cgroup (outside the slice): it carries
# only Unix sockets. It holds nothing of the caller's terminal.
as_target "$DIRECT_PROXY" --fd=3 "unix:path=$RUNDIR/bus" "$BUSSOCK" --filter "${BUS_POLICY[@]}" \
  3>&"$SYNC_W" {SYNC_R}<&- {SYNC_W}>&- </dev/null >/dev/null 2>&1 &
exec {SYNC_W}>&-
# Fail closed: no byte within 5 s (it exited, or hangs) means no Chrome.
IFS= read -r -N1 -t 5 -u "$SYNC_R" _ \
  || refuse "Chrome's filtered session bus (xdg-dbus-proxy) did not start - refusing"
[[ -S "$BUSSOCK" ]] || refuse "Chrome's filtered session bus has no socket ($BUSSOCK) - refusing"

# The same environment qbt-launch gives qBittorrent (vpnkit_gui_env), except
# the session bus, which is the proxy; plus XDG_CONFIG_HOME, so the package
# script finds chrome-flags.conf where it was checked above, and a PATH that
# starts with the kit's xdg-open.
vpnkit_gui_env "$TARGET_USER" "$TARGET_UID"
ENVV=()
for v in "${VPNKIT_GUI_ENV[@]}"; do
  [[ "$v" == DBUS_SESSION_BUS_ADDRESS=* ]] || ENVV+=("$v")
done
ENVV+=(DBUS_SESSION_BUS_ADDRESS="unix:path=$BUSSOCK" XDG_CONFIG_HOME="$THOME/.config"
       PATH="$DIRECT_PATH_DIR:/usr/local/sbin:/usr/local/bin:/usr/bin")

# The scope is created in the slice while this is still root; systemd-run then
# drops to the user (with the user's groups) and runs Chrome in it.
RUN=(systemd-run --scope --quiet --slice="$DIRECT_SLICE" --uid="$TARGET_USER" --gid="$TGROUP"
     -- env "${ENVV[@]}" "$DIRECT_BIN" "$@")

cd "$THOME" 2>/dev/null || cd /
if [[ -z "$DIRECT_DNS" ]]; then
  exec "${RUN[@]}"     # no DIRECT_DNS: Chrome uses the system resolver
fi

# Inside the new mount namespace, as root: the resolver files, then Chrome.
# $1 is DIRECT_DNS (checked above), the rest is the command.
# shellcheck disable=SC2016
INNER='
set -euo pipefail
. /usr/local/lib/vpnkit/common.sh
dns=$1; shift
d=/run/systemd/resolve
mount -t tmpfs -o mode=755,size=64k,nosuid,nodev,noexec vpnkit-direct "$d"
printf "# Chrome direct (omarchy-proton): names are resolved by DIRECT_DNS only.\nnameserver %s\noptions edns0 trust-ad\n" "$dns" > "$d/stub-resolv.conf"
cp "$d/stub-resolv.conf" "$d/resolv.conf"
# Without resolve and mdns: those reach systemd-resolved, which would answer
# with the VPN resolver. The same file as the torrent namespace.
vpnkit_ns_nsswitch > "$d/nsswitch.conf"
chmod 644 "$d/stub-resolv.conf" "$d/resolv.conf" "$d/nsswitch.conf"
mount --bind "$d/nsswitch.conf" /etc/nsswitch.conf
# Fail closed: start Chrome only when what it will read is right.
vpnkit_resolver_safe /etc || { echo "direct-launch: the private resolver files are not in place - refusing" >&2; exit 1; }
[[ "$(grep "^nameserver" /etc/resolv.conf)" == "nameserver $dns" ]] \
  || { echo "direct-launch: /etc/resolv.conf does not name DIRECT_DNS - refusing" >&2; exit 1; }
exec "$@"
'
exec unshare --mount --propagation slave -- bash -c "$INNER" direct-launch "$DIRECT_DNS" "${RUN[@]}"
